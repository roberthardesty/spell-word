# --- ESP-IDF build output ---
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# --- Host-side build output ---
# core .o files get dropped next to the source by tools/<name>_replay/Makefile.
components/segmenter/*.o
components/decoder/*.o
components/letter_recognizer/*.o
components/spell_ui/*.o

# --- Model binaries (staged for parttool.py, not source) ---
# The trained DS-CNN .tflite is generated by the upstream model-training
# project and dropped here for `parttool.py write_partition`. The blob is
# device-specific and re-trains; keep it out of source.
models/*.tflite

