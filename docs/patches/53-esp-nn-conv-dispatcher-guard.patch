# Vikunja #53 — esp-nn dispatcher guard fix (load-bearing)
#
# Target: managed_components/espressif__esp-nn/src/convolution/esp_nn_conv_esp32s3.c
# Tested against: esp-nn 1.2.3 (per dependencies.lock at time of fix, 2026-05-07)
# Marker:  "Vikunja #53"  (must be present in the patched file — this is how
#          the build's auto-apply step detects "already applied").
#
# WHY THIS PATCH EXISTS
# ---------------------
# `managed_components/` is gitignored. The IDF Component Manager re-fetches
# vendored deps on `idf.py reconfigure` / `fullclean` / fresh checkout, which
# would silently overwrite this fix and regress invoke from 84 ms to 532 ms.
# To prevent that, this patch is auto-applied at CMake configure time — see
# docs/patches/README.md for the architecture and cmake/apply_patches.cmake
# for the apply mechanics. You should not normally need to touch this file
# by hand.
#
# WHAT IT DOES
# ------------
# The TFLM glue at managed_components/espressif__esp-tflite-micro/.../conv.cc
# sets filter_dims.channels = 0 by convention (filter channels are derived
# from input). The esp-nn S3 dispatcher had a grouped-conv guard
#     if (channels != filter_dims->channels) { ... fall back to ansi ... }
# that misinterpreted that 0 as "different from input channels", so EVERY
# Conv2D from TFLM mis-routed to esp_nn_conv_s8_ansi (the pure-C reference
# kernel) and the SIMD paths were unreachable. Probe cyc/MAC dropped from
# unmeasurable (probe never fired — call site unreachable) to 0.71 cyc/MAC
# after this fix. Conv2D total dropped from 495 ms to 47 ms (10.5×). Total
# invoke dropped from 532 ms to 84 ms cold / 76 ms warm (6.3×).
#
# Also note: the grouped-conv guard was almost certainly added by an earlier
# session that also left the dead 3×3-opt code in this file. Both fixes/edits
# share the same comment style ("Grouped conv (filter_ch < input_ch): ...").
# Upstream esp-nn 1.2.3 may not have had this guard at all.
#
# HOW TO APPLY (escape hatch only — normally automatic)
# -----------------------------------------------------
# `idf.py build` / `idf.py reconfigure` applies this automatically via the
# CMake step in apply_patches.cmake. To apply by hand if the auto-apply is
# disabled or you are operating outside the build:
#   patch -p1 -i docs/patches/53-esp-nn-conv-dispatcher-guard.patch
# To revert by hand:
#   patch -R -p1 -i docs/patches/53-esp-nn-conv-dispatcher-guard.patch
# Or by hand: change the `if (channels != filter_dims->channels)` line in
# esp_nn_conv_s8_esp32s3() to also check filter_dims->channels != 0.
#
# IF AUTO-APPLY FAILS AT CONFIGURE TIME
# -------------------------------------
# Most likely cause: the upstream esp-nn version was bumped and the diff
# context lines no longer match. See "If you see APPLY FAILED" in
# docs/patches/README.md for the diagnosis playbook.
#
# LONG-TERM
# ---------
# The right fix is upstream — either esp-nn treats 0 as unspecified, or
# the TFLM glue passes the actual filter channels. Once that lands and
# the dependency is bumped past it, delete this patch and the matching
# apply_repo_patch() call in the top-level CMakeLists.txt.

--- a/managed_components/espressif__esp-nn/src/convolution/esp_nn_conv_esp32s3.c
+++ b/managed_components/espressif__esp-nn/src/convolution/esp_nn_conv_esp32s3.c
@@ -433,8 +433,11 @@ void esp_nn_conv_s8_esp32s3(const data_dims_t *input_dims,
     const int32_t activation_min = conv_params->activation.min;
     const int32_t activation_max = conv_params->activation.max;

-    /* Grouped conv (filter_ch < input_ch): fall back to ansi which handles it */
-    if (channels != filter_dims->channels) {
+    /* Grouped conv (filter_ch < input_ch): fall back to ansi which handles it.
+     * Vikunja #53: filter_dims->channels == 0 is the TFLM-glue convention for
+     * "unspecified, derive from input"; treat that as non-grouped. Without
+     * this, every Conv2D from TFLM mis-routes to ansi (full SIMD bypass). */
+    if (filter_dims->channels != 0 && channels != filter_dims->channels) {
         esp_nn_conv_s8_ansi(input_dims, input, filter_dims, filter_data,
                             bias, output_dims, out_data, conv_params, quant_data);
         return;
